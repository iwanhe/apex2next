  },
  "dependencies": {
    "@apex2next/shared-runtime": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
